# WireGuard settings from your VPN provider's config file
VPN_ENDPOINT_IP=203.0.113.10
VPN_ENDPOINT_PORT=51820
WIREGUARD_PUBLIC_KEY=your-server-public-key
WIREGUARD_PRIVATE_KEY=your-client-private-key
WIREGUARD_ADDRESSES=10.0.0.2/32

# Samba login (use the same as your Jellyfin user if you like). No ';' in the password.
SMB_USER=youruser
SMB_PASSWORD=change-me
